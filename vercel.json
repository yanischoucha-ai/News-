{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/fr/tribune",
      "destination": "/api/contrib?lang=fr"
    },
    {
      "source": "/fr/tribune/:slug",
      "destination": "/api/contrib?lang=fr&slug=:slug"
    },
    {
      "source": "/en/community",
      "destination": "/api/contrib?lang=en"
    },
    {
      "source": "/en/community/:slug",
      "destination": "/api/contrib?lang=en&slug=:slug"
    },
    {
      "source": "/sitemap-tribune.xml",
      "destination": "/api/contrib?sitemap=1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/fr",
      "destination": "/fr/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/fr/(.*)",
      "destination": "/fr/$1"
    },
    {
      "source": "/en/(.*)",
      "destination": "/en/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    }
  ],
  "functions": {
    "api/contrib.js": {
      "includeFiles": "{fr/reutilisation-contenu.html,en/content-reuse.html,assets/js/md.js}"
    }
  },
  "redirects": [
    {
      "source": "/fr/categorie/airbnb",
      "destination": "/fr/categorie/hotes",
      "permanent": true
    },
    {
      "source": "/en/category/airbnb",
      "destination": "/en/category/hotes",
      "permanent": true
    },
    {
      "source": "/fr/categorie/immobilier",
      "destination": "/fr/categorie/hotes",
      "permanent": true
    },
    {
      "source": "/en/category/immobilier",
      "destination": "/en/category/hotes",
      "permanent": true
    },
    {
      "source": "/fr/categorie/durable",
      "destination": "/fr/categorie/hotes",
      "permanent": true
    },
    {
      "source": "/en/category/durable",
      "destination": "/en/category/hotes",
      "permanent": true
    },
    {
      "source": "/fr/categorie/ia",
      "destination": "/fr/categorie/saas",
      "permanent": true
    },
    {
      "source": "/en/category/ia",
      "destination": "/en/category/saas",
      "permanent": true
    },
    {
      "source": "/fr/categorie/tech",
      "destination": "/fr/categorie/saas",
      "permanent": true
    },
    {
      "source": "/en/category/tech",
      "destination": "/en/category/saas",
      "permanent": true
    },
    {
      "source": "/fr/categorie/business",
      "destination": "/fr/categorie/saas",
      "permanent": true
    },
    {
      "source": "/en/category/business",
      "destination": "/en/category/saas",
      "permanent": true
    },
    {
      "source": "/fr/categorie/social",
      "destination": "/fr/categorie/saas",
      "permanent": true
    },
    {
      "source": "/en/category/social",
      "destination": "/en/category/saas",
      "permanent": true
    },
    {
      "source": "/en/heat-pump-rental-uk-price-cap-ratio-2026",
      "destination": "/en/heat-pump-short-term-rental-us-tax-credit-gone-depreciation-math-2026",
      "permanent": true
    }
  ]
}